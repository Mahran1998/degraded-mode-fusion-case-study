@@ -0,0 +1,336 @@
+// Copyright Institute for Automotive Engineering (ika), RWTH Aachen University
+// SPDX-License-Identifier: Apache-2.0
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+#include <point_cloud_fusion/input_availability.hpp>
+
+namespace point_cloud_fusion {
+
+namespace {
+
+/// Lower edge of the first histogram bucket.
+constexpr double kHistogramBaseNs = 1000.0;
+
+}  // namespace
+
+const char* toString(const InputAvailability state) {
+  switch (state) {
+    case InputAvailability::kUnknown:
+      return "UNKNOWN";
+    case InputAvailability::kHealthy:
+      return "HEALTHY";
+    case InputAvailability::kStale:
+      return "STALE";
+    case InputAvailability::kRecovering:
+      return "RECOVERING";
+  }
+  return "INVALID";
+}
+
+const char* toString(const AggregateAvailability state) {
+  switch (state) {
+    case AggregateAvailability::kNominal:
+      return "NOMINAL";
+    case AggregateAvailability::kDegraded:
+      return "DEGRADED";
+    case AggregateAvailability::kInsufficient:
+      return "INSUFFICIENT";
+  }
+  return "INVALID";
+}
+
+std::size_t DurationHistogram::bucketIndex(const std::int64_t duration_ns) {
+  const double ratio = static_cast<double>(duration_ns) / kHistogramBaseNs;
+  if (ratio <= 1.0) {
+    return 0;
+  }
+  const double position = std::floor(static_cast<double>(kBucketsPerOctave) * std::log2(ratio));
+  return std::min(static_cast<std::size_t>(position), kBucketCount - 1);
+}
+
+std::int64_t DurationHistogram::bucketUpperBound(const std::size_t bucket) {
+  const double exponent = static_cast<double>(bucket + 1) / static_cast<double>(kBucketsPerOctave);
+  return static_cast<std::int64_t>(std::ceil(kHistogramBaseNs * std::exp2(exponent)));
+}
+
+void DurationHistogram::add(const std::int64_t duration_ns) {
+  if (duration_ns < 0) {
+    return;
+  }
+  ++buckets_.at(bucketIndex(duration_ns));
+  ++count_;
+  max_ns_ = std::max(max_ns_, duration_ns);
+  sum_ns_ += static_cast<double>(duration_ns);
+}
+
+double DurationHistogram::mean() const { return count_ == 0 ? 0.0 : sum_ns_ / static_cast<double>(count_); }
+
+std::int64_t DurationHistogram::quantileUpperBound(const double q) const {
+  if (count_ == 0) {
+    return 0;
+  }
+  const double clamped = std::clamp(q, 0.0, 1.0);
+  const auto target = std::max<std::uint64_t>(1, static_cast<std::uint64_t>(std::ceil(clamped * static_cast<double>(count_))));
+  std::uint64_t cumulative = 0;
+  for (std::size_t bucket = 0; bucket < kBucketCount; ++bucket) {
+    cumulative += buckets_.at(bucket);
+    if (cumulative >= target) {
+      return std::min(bucketUpperBound(bucket), max_ns_);
+    }
+  }
+  return max_ns_;
+}
+
+InputAvailabilityMonitor::InputAvailabilityMonitor(const std::size_t input_count, const std::int64_t timeout_ns)
+    : input_count_(input_count), min_inputs_(defaultMinInputs(input_count)), timeout_ns_(timeout_ns) {
+  if (input_count == 0 || input_count > kMaxInputs) {
+    throw std::invalid_argument("InputAvailabilityMonitor: input_count must be in [1, 9]");
+  }
+  if (timeout_ns <= 0) {
+    throw std::invalid_argument("InputAvailabilityMonitor: timeout_ns must be positive");
+  }
+}
+
+std::size_t InputAvailabilityMonitor::defaultMinInputs(const std::size_t input_count) {
+  if (input_count <= 2) {
+    return 1;
+  }
+  return (input_count + 1) / 2;
+}
+
+void InputAvailabilityMonitor::reset(const std::int64_t now_ns) {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  resetLocked(now_ns);
+}
+
+void InputAvailabilityMonitor::onArrival(const std::size_t input, const std::int64_t now_ns, const std::int64_t stamp_ns) {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  if (input >= input_count_) {
+    return;
+  }
+  InputRecord& record = inputs_.at(input);
+  InputSnapshot& data = record.data;
+  ++data.arrivals;
+  if (now_ns == 0) {
+    ++data.arrivals_before_clock;
+    return;
+  }
+  anchorEpochLocked(now_ns);
+
+  // Header stamps feed statistics only; they never influence availability.
+  if (stamp_ns == 0) {
+    ++data.stamp_zero;
+  } else {
+    if (record.has_stamp) {
+      const std::int64_t stamp_delta = stamp_ns - record.last_stamp_ns;
+      if (stamp_delta > 0) {
+        data.stamp_gap.add(stamp_delta);
+      } else if (stamp_delta == 0) {
+        ++data.stamp_repeats;
+      } else {
+        ++data.stamp_regressions;
+      }
+    }
+    record.last_stamp_ns = stamp_ns;
+    record.has_stamp = true;
+  }
+
+  // Arrival gaps: a gap that ends while the input is STALE is a silence, every other gap is a normal gap.
+  if (!record.has_arrival) {
+    record.has_arrival = true;
+    data.last_arrival_ns = now_ns;
+  } else if (now_ns < data.last_arrival_ns) {
+    ++data.arrival_clamps;
+  } else {
+    const std::int64_t gap_ns = now_ns - data.last_arrival_ns;
+    if (data.state == InputAvailability::kStale) {
+      data.silence.add(gap_ns);
+    } else {
+      data.normal_gap.add(gap_ns);
+    }
+    data.last_arrival_ns = now_ns;
+  }
+
+  switch (data.state) {
+    case InputAvailability::kUnknown:
+      setInputStateLocked(input, InputAvailability::kHealthy, now_ns);
+      break;
+    case InputAvailability::kStale:
+      record.rec_since_ns = now_ns;
+      setInputStateLocked(input, InputAvailability::kRecovering, now_ns);
+      break;
+    case InputAvailability::kRecovering:
+      if (now_ns - record.rec_since_ns >= kRecoveryWindowNs) {
+        data.recovery_time.add(now_ns - record.rec_since_ns);
+        setInputStateLocked(input, InputAvailability::kHealthy, now_ns);
+      }
+      break;
+    case InputAvailability::kHealthy:
+      break;
+  }
+  updateAggregateLocked(now_ns);
+}
+
+void InputAvailabilityMonitor::onTick(const std::int64_t now_ns) {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  if (now_ns == 0) {
+    return;
+  }
+  if (has_tick_ && now_ns < last_tick_ns_) {
+    ++time_jumps_;
+    resetLocked(now_ns);
+    has_tick_ = true;
+    last_tick_ns_ = now_ns;
+    return;
+  }
+  has_tick_ = true;
+  last_tick_ns_ = now_ns;
+  anchorEpochLocked(now_ns);
+
+  for (std::size_t input = 0; input < input_count_; ++input) {
+    InputRecord& record = inputs_.at(input);
+    InputSnapshot& data = record.data;
+    switch (data.state) {
+      case InputAvailability::kUnknown:
+        if (now_ns - epoch_ns_ > timeout_ns_) {
+          setInputStateLocked(input, InputAvailability::kStale, now_ns);
+        }
+        break;
+      case InputAvailability::kHealthy:
+      case InputAvailability::kRecovering:
+        if (now_ns - data.last_arrival_ns > timeout_ns_) {
+          data.detect_latency.add(now_ns - data.last_arrival_ns);
+          setInputStateLocked(input, InputAvailability::kStale, now_ns);
+        } else if (data.state == InputAvailability::kRecovering && now_ns - record.rec_since_ns >= kRecoveryWindowNs) {
+          data.recovery_time.add(now_ns - record.rec_since_ns);
+          setInputStateLocked(input, InputAvailability::kHealthy, now_ns);
+        }
+        break;
+      case InputAvailability::kStale:
+        break;
+    }
+  }
+  updateAggregateLocked(now_ns);
+}
+
+void InputAvailabilityMonitor::recordObserverCost(const std::int64_t cost_ns) {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  observer_cost_.add(cost_ns);
+}
+
+void InputAvailabilityMonitor::drainTransitions(TransitionLog& log) {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  log.count = pending_.count;
+  for (std::size_t index = 0; index < pending_.count; ++index) {
+    log.records.at(index) = pending_.records.at(index);
+  }
+  pending_.count = 0;
+}
+
+void InputAvailabilityMonitor::snapshot(Snapshot& snapshot) const {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  snapshot.input_count = input_count_;
+  snapshot.min_inputs = min_inputs_;
+  snapshot.timeout_ns = timeout_ns_;
+  snapshot.epoch_ns = epoch_ns_;
+  snapshot.aggregate = aggregate_;
+  snapshot.aggregate_transitions = aggregate_transitions_;
+  snapshot.time_jumps = time_jumps_;
+  snapshot.transitions_dropped = transitions_dropped_;
+  snapshot.observer_cost = observer_cost_;
+  for (std::size_t input = 0; input < input_count_; ++input) {
+    snapshot.inputs.at(input) = inputs_.at(input).data;
+  }
+}
+
+InputAvailability InputAvailabilityMonitor::inputState(const std::size_t input) const {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  return inputs_.at(input).data.state;
+}
+
+AggregateAvailability InputAvailabilityMonitor::aggregateState() const {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  return aggregate_;
+}
+
+void InputAvailabilityMonitor::anchorEpochLocked(const std::int64_t now_ns) {
+  if (epoch_pending_) {
+    epoch_ns_ = now_ns;
+    epoch_pending_ = false;
+  }
+}
+
+void InputAvailabilityMonitor::setInputStateLocked(const std::size_t input,
+                                                   const InputAvailability next,
+                                                   const std::int64_t now_ns) {
+  InputSnapshot& data = inputs_.at(input).data;
+  if (data.state == next) {
+    return;
+  }
+  ++data.transitions.at(static_cast<std::size_t>(data.state)).at(static_cast<std::size_t>(next));
+  Transition transition;
+  transition.input = input;
+  transition.input_from = data.state;
+  transition.input_to = next;
+  transition.time_ns = now_ns;
+  logTransitionLocked(transition);
+  data.state = next;
+}
+
+void InputAvailabilityMonitor::updateAggregateLocked(const std::int64_t now_ns) {
+  std::size_t available = 0;
+  for (std::size_t input = 0; input < input_count_; ++input) {
+    const InputAvailability state = inputs_.at(input).data.state;
+    if (state == InputAvailability::kHealthy || state == InputAvailability::kUnknown) {
+      ++available;
+    }
+  }
+  AggregateAvailability next = AggregateAvailability::kInsufficient;
+  if (available == input_count_) {
+    next = AggregateAvailability::kNominal;
+  } else if (available >= min_inputs_) {
+    next = AggregateAvailability::kDegraded;
+  }
+  if (next == aggregate_) {
+    return;
+  }
+  ++aggregate_transitions_.at(static_cast<std::size_t>(aggregate_)).at(static_cast<std::size_t>(next));
+  Transition transition;
+  transition.aggregate = true;
+  transition.aggregate_from = aggregate_;
+  transition.aggregate_to = next;
+  transition.time_ns = now_ns;
+  logTransitionLocked(transition);
+  aggregate_ = next;
+}
+
+void InputAvailabilityMonitor::logTransitionLocked(const Transition& transition) {
+  if (pending_.count < kTransitionCapacity) {
+    pending_.records.at(pending_.count) = transition;
+    ++pending_.count;
+  } else {
+    ++transitions_dropped_;
+  }
+}
+
+void InputAvailabilityMonitor::resetLocked(const std::int64_t now_ns) {
+  for (std::size_t input = 0; input < input_count_; ++input) {
+    InputRecord& record = inputs_.at(input);
+    setInputStateLocked(input, InputAvailability::kUnknown, now_ns);
+    record.data.last_arrival_ns = 0;
+    record.rec_since_ns = 0;
+    record.last_stamp_ns = 0;
+    record.has_arrival = false;
+    record.has_stamp = false;
+  }
+  epoch_ns_ = now_ns;
+  epoch_pending_ = now_ns == 0;
+  has_tick_ = false;
+  last_tick_ns_ = 0;
+  updateAggregateLocked(now_ns);
+}
+
+}  // namespace point_cloud_fusion
