+void PointCloudFusion::observeInputArrival(const std::size_t input, const PointCloudMsg::ConstSharedPtr& msg) {
+  const auto start = std::chrono::steady_clock::now();
+  const std::int64_t now_ns = this->get_clock()->now().nanoseconds();
+  const std::int64_t stamp_ns = msg ? rclcpp::Time(msg->header.stamp).nanoseconds() : 0;
+  availability_monitor_->onArrival(input, now_ns, stamp_ns);
+  availability_monitor_->recordObserverCost(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+}
+
+void PointCloudFusion::evaluateInputAvailability() {
+  const std::int64_t now_ns = this->get_clock()->now().nanoseconds();
+  availability_monitor_->onTick(now_ns);
+  availability_monitor_->drainTransitions(availability_transitions_);
+  for (std::size_t index = 0; index < availability_transitions_.count; ++index) {
+    const auto& transition = availability_transitions_.records.at(index);
+    if (transition.aggregate) {
+      RCLCPP_DEBUG(this->get_logger(), "Input availability: %s -> %s", toString(transition.aggregate_from),
+                   toString(transition.aggregate_to));
+    } else {
+      RCLCPP_DEBUG(this->get_logger(), "Input availability: input %zu ('%s') %s -> %s", transition.input,
+                   input_topics_.at(transition.input).c_str(), toString(transition.input_from), toString(transition.input_to));
+    }
+  }
+
+  const bool debug_enabled = rcutils_logging_logger_is_enabled_for(this->get_logger().get_name(), RCUTILS_LOG_SEVERITY_DEBUG);
+  if (debug_enabled &&
+      (now_ns < availability_last_summary_ns_ || now_ns - availability_last_summary_ns_ >= kAvailabilitySummaryPeriodNs)) {
+    availability_last_summary_ns_ = now_ns;
+    logInputAvailabilitySummary();
+  }
+}
+
+void PointCloudFusion::logInputAvailabilitySummary() {
+  availability_monitor_->snapshot(availability_snapshot_);
+  const auto& snapshot = availability_snapshot_;
+  const auto to_ms = [](const std::int64_t ns) { return static_cast<double>(ns) * 1e-6; };
+  const auto to_us = [](const std::int64_t ns) { return static_cast<double>(ns) * 1e-3; };
+  RCLCPP_DEBUG(this->get_logger(),
+               "Input availability summary: %s, inputs=%zu, min_inputs=%zu, timeout=%.0f ms, time_jumps=%" PRIu64
+               ", dropped_transitions=%" PRIu64 ", observer cost [us] p50=%.1f p99=%.1f max=%.1f (n=%" PRIu64 ")",
+               toString(snapshot.aggregate), snapshot.input_count, snapshot.min_inputs, to_ms(snapshot.timeout_ns),
+               snapshot.time_jumps, snapshot.transitions_dropped, to_us(snapshot.observer_cost.quantileUpperBound(0.5)),
+               to_us(snapshot.observer_cost.quantileUpperBound(0.99)), to_us(snapshot.observer_cost.max()),
+               snapshot.observer_cost.count());
+  for (std::size_t input = 0; input < snapshot.input_count; ++input) {
+    const auto& data = snapshot.inputs.at(input);
+    RCLCPP_DEBUG(this->get_logger(),
+                 "Input availability [%zu] '%s': %s, arrivals=%" PRIu64 " (before clock %" PRIu64 ", clamped %" PRIu64
+                 "); gap [ms] n=%" PRIu64 " p50=%.1f p99=%.1f p99.9=%.1f max=%.1f; silence n=%" PRIu64
+                 " max=%.1f ms; detect n=%" PRIu64 " max=%.1f ms; recovery n=%" PRIu64
+                 " max=%.1f ms; stamp gap p50=%.1f "
+                 "max=%.1f ms, zero=%" PRIu64 " repeat=%" PRIu64 " regress=%" PRIu64,
