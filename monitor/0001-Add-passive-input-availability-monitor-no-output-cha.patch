+                 data.arrival_clamps, data.normal_gap.count(), to_ms(data.normal_gap.quantileUpperBound(0.5)),
+                 to_ms(data.normal_gap.quantileUpperBound(0.99)), to_ms(data.normal_gap.quantileUpperBound(0.999)),
