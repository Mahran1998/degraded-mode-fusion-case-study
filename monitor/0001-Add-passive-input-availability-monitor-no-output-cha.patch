--- /dev/null
+++ b/point_cloud_fusion/test/test_input_availability.cpp
@@ -0,0 +1,383 @@
+// Copyright Institute for Automotive Engineering (ika), RWTH Aachen University
+// SPDX-License-Identifier: Apache-2.0
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+#include <point_cloud_fusion/input_availability.hpp>
+
+namespace {
+
+using point_cloud_fusion::AggregateAvailability;
+using point_cloud_fusion::DurationHistogram;
+using point_cloud_fusion::InputAvailability;
+using point_cloud_fusion::InputAvailabilityMonitor;
+
+/**
+ * @brief Convert milliseconds to nanoseconds.
+ *
+ * @param milliseconds Duration in milliseconds.
+ * @return Duration in nanoseconds.
+ */
+constexpr std::int64_t ms(const std::int64_t milliseconds) { return milliseconds * 1'000'000; }
+
+constexpr std::int64_t kTimeout = ms(300);
+
+TEST(InputAvailabilityMonitor, RejectsInvalidConfiguration) {
+  EXPECT_THROW(InputAvailabilityMonitor(0, kTimeout), std::invalid_argument);
+  EXPECT_THROW(InputAvailabilityMonitor(InputAvailabilityMonitor::kMaxInputs + 1, kTimeout), std::invalid_argument);
+  EXPECT_THROW(InputAvailabilityMonitor(2, 0), std::invalid_argument);
+  EXPECT_EQ(InputAvailabilityMonitor::defaultMinInputs(1), 1U);
+  EXPECT_EQ(InputAvailabilityMonitor::defaultMinInputs(2), 1U);
+  EXPECT_EQ(InputAvailabilityMonitor::defaultMinInputs(4), 2U);
+  EXPECT_EQ(InputAvailabilityMonitor::defaultMinInputs(9), 5U);
+}
+
+// T1: one global epoch; UNKNOWN counts as available until the startup grace T has passed.
+TEST(InputAvailabilityMonitor, StartupGraceUsesOneGlobalEpoch) {
+  InputAvailabilityMonitor monitor(4, kTimeout);
+  monitor.reset(ms(1000));
+  monitor.onTick(ms(1300));
+  for (std::size_t input = 0; input < 4; ++input) {
+    EXPECT_EQ(monitor.inputState(input), InputAvailability::kUnknown);
+  }
+  EXPECT_EQ(monitor.aggregateState(), AggregateAvailability::kNominal);
+
+  monitor.onTick(ms(1310));
+  for (std::size_t input = 0; input < 4; ++input) {
+    EXPECT_EQ(monitor.inputState(input), InputAvailability::kStale);
+  }
+  EXPECT_EQ(monitor.aggregateState(), AggregateAvailability::kInsufficient);
+}
+
+// T2: HEALTHY -> STALE at the first tick with now - last_arrival > T; the detection latency is recorded.
+TEST(InputAvailabilityMonitor, DetectsSilenceAtFirstTickPastTimeout) {
+  InputAvailabilityMonitor monitor(2, kTimeout);
+  monitor.reset(ms(1000));
+  monitor.onArrival(0, ms(1100), ms(1100));
+  monitor.onArrival(1, ms(1100), ms(1100));
+  monitor.onTick(ms(1400));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kHealthy);
+
+  monitor.onTick(ms(1410));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kStale);
+  EXPECT_EQ(monitor.inputState(1), InputAvailability::kStale);
+
+  InputAvailabilityMonitor::Snapshot snapshot;
+  monitor.snapshot(snapshot);
+  EXPECT_EQ(snapshot.inputs.at(0).detect_latency.count(), 1U);
+  EXPECT_EQ(snapshot.inputs.at(0).detect_latency.max(), ms(310));
+}
+
+// T3: STALE -> RECOVERING on arrival, HEALTHY after 500 ms of arrivals, back to STALE on a gap > T while recovering.
+TEST(InputAvailabilityMonitor, RecoversAfterWindowAndFallsBackOnSilence) {
+  InputAvailabilityMonitor monitor(1, kTimeout);
+  monitor.reset(ms(1000));
+  for (std::int64_t t = ms(1000); t <= ms(2000); t += ms(100)) {
+    monitor.onArrival(0, t, t);
+  }
+  monitor.onTick(ms(2310));
+  ASSERT_EQ(monitor.inputState(0), InputAvailability::kStale);
+
+  monitor.onArrival(0, ms(3000), ms(3000));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kRecovering);
+  for (std::int64_t t = ms(3100); t < ms(3500); t += ms(100)) {
+    monitor.onArrival(0, t, t);
+    monitor.onTick(t + ms(5));
+    EXPECT_EQ(monitor.inputState(0), InputAvailability::kRecovering);
+  }
+  monitor.onArrival(0, ms(3500), ms(3500));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kHealthy);
+
+  InputAvailabilityMonitor::Snapshot snapshot;
+  monitor.snapshot(snapshot);
+  EXPECT_EQ(snapshot.inputs.at(0).silence.count(), 1U);
+  EXPECT_EQ(snapshot.inputs.at(0).silence.max(), ms(1000));
+  EXPECT_EQ(snapshot.inputs.at(0).recovery_time.count(), 1U);
+  EXPECT_EQ(snapshot.inputs.at(0).recovery_time.max(), ms(500));
+
+  monitor.onTick(ms(3810));
+  ASSERT_EQ(monitor.inputState(0), InputAvailability::kStale);
+  monitor.onArrival(0, ms(5000), ms(5000));
+  ASSERT_EQ(monitor.inputState(0), InputAvailability::kRecovering);
+  monitor.onTick(ms(5310));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kStale);
+}
+
+// T4: aggregate mapping with the default minimum (1 for N <= 2, otherwise ceil(N / 2)).
+TEST(InputAvailabilityMonitor, AggregateUsesDefaultMinimum) {
+  for (const std::size_t input_count : {std::size_t{2}, std::size_t{4}, std::size_t{9}}) {
+    const std::size_t min_inputs = InputAvailabilityMonitor::defaultMinInputs(input_count);
+    for (std::size_t alive = 0; alive <= input_count; ++alive) {
+      InputAvailabilityMonitor monitor(input_count, kTimeout);
+      monitor.reset(ms(1000));
+      for (std::size_t input = 0; input < input_count; ++input) {
+        monitor.onArrival(input, ms(1000), ms(1000));
+      }
+      for (std::size_t input = 0; input < alive; ++input) {
+        monitor.onArrival(input, ms(1200), ms(1200));
+      }
+      monitor.onTick(ms(1310));
+      AggregateAvailability expected = AggregateAvailability::kInsufficient;
+      if (alive == input_count) {
+        expected = AggregateAvailability::kNominal;
+      } else if (alive >= min_inputs) {
+        expected = AggregateAvailability::kDegraded;
+      }
+      EXPECT_EQ(monitor.aggregateState(), expected) << "N=" << input_count << " alive=" << alive;
+    }
+  }
+}
+
+// RECOVERING inputs are not counted as available until they are HEALTHY again.
+TEST(InputAvailabilityMonitor, RecoveringInputIsNotCountedAsAvailable) {
+  InputAvailabilityMonitor monitor(2, kTimeout);
+  monitor.reset(ms(1000));
+  monitor.onArrival(0, ms(1000), ms(1000));
+  monitor.onArrival(1, ms(1000), ms(1000));
+  monitor.onArrival(0, ms(1200), ms(1200));
+  monitor.onTick(ms(1310));
+  ASSERT_EQ(monitor.aggregateState(), AggregateAvailability::kDegraded);
+  monitor.onArrival(1, ms(1400), ms(1400));
+  EXPECT_EQ(monitor.inputState(1), InputAvailability::kRecovering);
+  EXPECT_EQ(monitor.aggregateState(), AggregateAvailability::kDegraded);
+}
+
+// T5: a backward jump seen by onTick() starts a new epoch.
+TEST(InputAvailabilityMonitor, BackwardTickStartsNewEpoch) {
+  InputAvailabilityMonitor monitor(2, kTimeout);
+  monitor.reset(ms(5000));
+  monitor.onArrival(0, ms(5100), ms(5100));
+  monitor.onTick(ms(5200));
+  monitor.onTick(ms(4000));
+
+  InputAvailabilityMonitor::Snapshot snapshot;
+  monitor.snapshot(snapshot);
+  EXPECT_EQ(snapshot.time_jumps, 1U);
+  EXPECT_EQ(snapshot.epoch_ns, ms(4000));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kUnknown);
+  EXPECT_EQ(monitor.inputState(1), InputAvailability::kUnknown);
+  EXPECT_EQ(monitor.aggregateState(), AggregateAvailability::kNominal);
+
+  monitor.onTick(ms(4300));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kUnknown);
+  monitor.onTick(ms(4310));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kStale);
+}
+
+// T6: an arrival that read the clock before the last tick or before the last arrival never resets the state.
+TEST(InputAvailabilityMonitor, LateArrivalNeverResets) {
+  InputAvailabilityMonitor monitor(1, kTimeout);
+  monitor.reset(ms(1000));
+  monitor.onArrival(0, ms(2000), 1);
+  monitor.onTick(ms(2050));
+  monitor.onArrival(0, ms(2040), 2);
+  monitor.onArrival(0, ms(1990), 3);
+
+  InputAvailabilityMonitor::Snapshot snapshot;
+  monitor.snapshot(snapshot);
+  EXPECT_EQ(snapshot.time_jumps, 0U);
+  EXPECT_EQ(snapshot.inputs.at(0).arrival_clamps, 1U);
+  EXPECT_EQ(snapshot.inputs.at(0).normal_gap.count(), 1U);
+  EXPECT_EQ(snapshot.inputs.at(0).last_arrival_ns, ms(2040));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kHealthy);
+}
+
+// T7: a gap that crossed STALE is a silence, not a normal gap.
+TEST(InputAvailabilityMonitor, SeparatesSilenceFromNormalGaps) {
+  InputAvailabilityMonitor monitor(1, kTimeout);
+  monitor.reset(ms(1000));
+  monitor.onArrival(0, ms(1000), 1);
+  monitor.onArrival(0, ms(1100), 2);
+  monitor.onTick(ms(1410));
+  monitor.onArrival(0, ms(2000), 3);
+
+  InputAvailabilityMonitor::Snapshot snapshot;
+  monitor.snapshot(snapshot);
+  EXPECT_EQ(snapshot.inputs.at(0).normal_gap.count(), 1U);
+  EXPECT_EQ(snapshot.inputs.at(0).normal_gap.max(), ms(100));
+  EXPECT_EQ(snapshot.inputs.at(0).silence.count(), 1U);
+  EXPECT_EQ(snapshot.inputs.at(0).silence.max(), ms(900));
+}
+
+// T8: header stamps feed counters and the stamp histogram only.
+TEST(InputAvailabilityMonitor, HeaderStampPolicyDoesNotAffectAvailability) {
+  InputAvailabilityMonitor monitor(1, kTimeout);
+  monitor.reset(ms(1000));
+  monitor.onArrival(0, ms(1000), 0);
+  monitor.onArrival(0, ms(1100), ms(50));
+  monitor.onArrival(0, ms(1200), ms(150));
+  monitor.onArrival(0, ms(1300), ms(150));
+  monitor.onArrival(0, ms(1400), ms(90));
+
+  InputAvailabilityMonitor::Snapshot snapshot;
+  monitor.snapshot(snapshot);
+  const auto& input = snapshot.inputs.at(0);
+  EXPECT_EQ(input.stamp_zero, 1U);
+  EXPECT_EQ(input.stamp_repeats, 1U);
+  EXPECT_EQ(input.stamp_regressions, 1U);
+  EXPECT_EQ(input.stamp_gap.count(), 1U);
+  EXPECT_EQ(input.normal_gap.count(), 4U);
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kHealthy);
+}
+
+// T9: a full transition log drops records only; state and transition counters stay complete.
+TEST(InputAvailabilityMonitor, TransitionOverflowDropsRecordsOnly) {
+  InputAvailabilityMonitor monitor(1, kTimeout);
+  monitor.reset(ms(1000));
+  std::int64_t now = ms(1000);
+  monitor.onArrival(0, now, now);
+  constexpr int kCycles = 40;
+  for (int cycle = 0; cycle < kCycles; ++cycle) {
+    now += ms(310);
+    monitor.onTick(now);
+    now += ms(10);
+    monitor.onArrival(0, now, now);
+  }
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kRecovering);
+
+  InputAvailabilityMonitor::TransitionLog log;
+  monitor.drainTransitions(log);
+  InputAvailabilityMonitor::Snapshot snapshot;
+  monitor.snapshot(snapshot);
+  const auto& counts = snapshot.inputs.at(0).transitions;
+  std::uint64_t input_transitions = 0;
+  for (const auto& row : counts) {
+    for (const auto value : row) {
+      input_transitions += value;
+    }
+  }
+  std::uint64_t aggregate_transitions = 0;
+  for (const auto& row : snapshot.aggregate_transitions) {
+    for (const auto value : row) {
+      aggregate_transitions += value;
+    }
+  }
+  EXPECT_EQ(log.count, InputAvailabilityMonitor::kTransitionCapacity);
+  EXPECT_EQ(snapshot.transitions_dropped + log.count, input_transitions + aggregate_transitions);
+  EXPECT_GT(snapshot.transitions_dropped, 0U);
+
+  monitor.drainTransitions(log);
+  EXPECT_EQ(log.count, 0U);
+}
+
+// ROS time without /clock reads 0: such arrivals are only counted, and the epoch starts at the first non-zero time.
+TEST(InputAvailabilityMonitor, EpochWaitsForClockToStart) {
+  InputAvailabilityMonitor monitor(1, kTimeout);
+  monitor.reset(0);
+  monitor.onArrival(0, 0, 0);
+  monitor.onTick(0);
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kUnknown);
+
+  monitor.onTick(ms(100'000));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kUnknown);
+  monitor.onTick(ms(100'300));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kUnknown);
+  monitor.onTick(ms(100'310));
+  EXPECT_EQ(monitor.inputState(0), InputAvailability::kStale);
+
+  InputAvailabilityMonitor::Snapshot snapshot;
+  monitor.snapshot(snapshot);
+  EXPECT_EQ(snapshot.inputs.at(0).arrivals_before_clock, 1U);
+  EXPECT_EQ(snapshot.epoch_ns, ms(100'000));
+}
+
+/**
+ * @brief One expected transition: time, input index (-1 for aggregate), and target state name.
+ */
+struct ExpectedTransition {
+  std::int64_t time_ns;
+  int input;
+  const char* to;
+};
+
+// Same rules as the validated Python model (phase2f Level0F, T = 300 ms, window recovery, 10 ms ticks): the
+// expected transitions below were produced by that model for the same scripted trace (times shifted by +1 s
+// because 0 means "clock not started" here).
+TEST(InputAvailabilityMonitor, MatchesReferenceModelOnScriptedTrace) {
+  constexpr std::int64_t kOffset = ms(1000);
+  constexpr std::int64_t kTick = ms(10);
+  std::vector<std::pair<std::int64_t, std::size_t>> arrivals;
+  for (std::int64_t k = 0; k < 60; ++k) {
+    const std::int64_t t = ms(50) + k * ms(100);
+    arrivals.emplace_back(t, 0);
+    if (t + ms(3) < ms(2000) || t + ms(3) >= ms(3200)) {
+      arrivals.emplace_back(t + ms(3), 1);
+    }
+    if (t + ms(7) >= ms(950) && (t + ms(7) < ms(4000) || t + ms(7) >= ms(4250))) {
+      arrivals.emplace_back(t + ms(7), 2);
+    }
+  }
+  std::sort(arrivals.begin(), arrivals.end());
+
+  InputAvailabilityMonitor monitor(3, kTimeout);
+  monitor.reset(kOffset);
+  std::vector<ExpectedTransition> observed;
+  InputAvailabilityMonitor::TransitionLog log;
+  const auto collect = [&]() {
+    monitor.drainTransitions(log);
+    for (std::size_t index = 0; index < log.count; ++index) {
+      const auto& transition = log.records.at(index);
+      observed.push_back({transition.time_ns - kOffset, transition.aggregate ? -1 : static_cast<int>(transition.input),
+                          transition.aggregate ? point_cloud_fusion::toString(transition.aggregate_to)
+                                               : point_cloud_fusion::toString(transition.input_to)});
+    }
+  };
+  std::int64_t tick = 0;
+  for (const auto& [time, input] : arrivals) {
+    while (tick < time) {
+      monitor.onTick(tick + kOffset);
+      collect();
+      tick += kTick;
+    }
+    monitor.onArrival(input, time + kOffset, time);
+    collect();
+  }
+  const std::int64_t end = arrivals.back().first + ms(1000);
+  while (tick <= end) {
+    monitor.onTick(tick + kOffset);
+    collect();
+    tick += kTick;
+  }
+
+  const std::vector<ExpectedTransition> expected = {
+      {ms(50), 0, "HEALTHY"},     {ms(53), 1, "HEALTHY"},      {ms(310), 2, "STALE"},     {ms(310), -1, "DEGRADED"},
+      {ms(957), 2, "RECOVERING"}, {ms(1457), 2, "HEALTHY"},    {ms(1457), -1, "NOMINAL"}, {ms(2260), 1, "STALE"},
+      {ms(2260), -1, "DEGRADED"}, {ms(3253), 1, "RECOVERING"}, {ms(3753), 1, "HEALTHY"},  {ms(3753), -1, "NOMINAL"},
+      {ms(6260), 0, "STALE"},     {ms(6260), 1, "STALE"},      {ms(6260), 2, "STALE"},    {ms(6260), -1, "INSUFFICIENT"},
+  };
+  ASSERT_EQ(observed.size(), expected.size());
+  for (std::size_t index = 0; index < expected.size(); ++index) {
+    EXPECT_EQ(observed.at(index).time_ns, expected.at(index).time_ns) << "transition " << index;
+    EXPECT_EQ(observed.at(index).input, expected.at(index).input) << "transition " << index;
+    EXPECT_STREQ(observed.at(index).to, expected.at(index).to) << "transition " << index;
+  }
+}
+
+TEST(DurationHistogram, QuantilesAreBucketUpperBoundsCappedAtMax) {
+  DurationHistogram histogram;
+  EXPECT_EQ(histogram.quantileUpperBound(0.5), 0);
+  for (int sample = 0; sample < 99; ++sample) {
+    histogram.add(ms(100));
+  }
+  histogram.add(ms(250));
+  histogram.add(-1);
+  EXPECT_EQ(histogram.count(), 100U);
+  EXPECT_EQ(histogram.max(), ms(250));
+  const std::int64_t median = histogram.quantileUpperBound(0.5);
+  EXPECT_GE(median, ms(100));
+  EXPECT_LE(median, ms(110));
+  EXPECT_EQ(histogram.quantileUpperBound(1.0), ms(250));
+  EXPECT_EQ(DurationHistogram::bucketIndex(0), 0U);
+  EXPECT_EQ(DurationHistogram::bucketIndex(ms(1'000'000)), DurationHistogram::kBucketCount - 1);
+  for (std::size_t bucket = 1; bucket < DurationHistogram::kBucketCount; ++bucket) {
+    EXPECT_GT(DurationHistogram::bucketUpperBound(bucket), DurationHistogram::bucketUpperBound(bucket - 1));
+  }
+}
+
+}  // namespace
diff --git a/point_cloud_fusion/test/test_observer_no_copy.cpp b/point_cloud_fusion/test/test_observer_no_copy.cpp
new file mode 100644
index 0000000..f0184ce
--- /dev/null
+++ b/point_cloud_fusion/test/test_observer_no_copy.cpp
@@ -0,0 +1,236 @@
+// Copyright Institute for Automotive Engineering (ika), RWTH Aachen University
+// SPDX-License-Identifier: Apache-2.0
+
+// The arrival observer adds one callback to every input filter, in front of the synchronizer. These tests check,
+// against the installed message_filters, that a const observer neither copies messages nor changes what the
+// approximate-time synchronizer outputs.
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+#include <message_filters/simple_filter.h>
+#include <message_filters/sync_policies/approximate_time.h>
+#include <message_filters/synchronizer.h>
+#include <sensor_msgs/msg/point_cloud2.hpp>
+
+namespace {
+
+using Cloud = sensor_msgs::msg::PointCloud2;
+using CloudConstPtr = Cloud::ConstSharedPtr;
+
+/**
+ * @brief Input filter that forwards a shared pointer exactly like point_cloud_transport::SubscriberFilter::cb().
+ */
+class ForwardingFilter : public message_filters::SimpleFilter<Cloud> {
+ public:
+  /**
+   * @brief Signal one message to all registered callbacks.
+   *
+   * @param msg Message to forward.
+   */
+  void forward(const CloudConstPtr& msg) { this->signalMessage(msg); }
+};
+
+/**
+ * @brief Create a point cloud with a given header stamp and a width that identifies it.
+ *
+ * @param stamp_ns Header stamp in nanoseconds.
+ * @param id Value stored in width.
+ * @return New message.
+ */
+CloudConstPtr makeCloud(const std::int64_t stamp_ns, const std::uint32_t id) {
+  auto msg = std::make_shared<Cloud>();
+  msg->header.stamp.sec = static_cast<std::int32_t>(stamp_ns / 1'000'000'000);
+  msg->header.stamp.nanosec = static_cast<std::uint32_t>(stamp_ns % 1'000'000'000);
+  msg->header.frame_id = "sensor";
+  msg->height = 1;
+  msg->width = id;
+  return msg;
+}
+
+/**
+ * @brief Approximate-time policy with N point-cloud inputs.
+ *
+ * @tparam N Number of inputs (2 or 4).
+ */
+template <std::size_t N>
+struct PolicyFor;
+
+/** @brief Two inputs. */
+template <>
+struct PolicyFor<2> {
+  using Type = message_filters::sync_policies::ApproximateTime<Cloud, Cloud>;
+};
+
+/** @brief Four inputs. */
+template <>
+struct PolicyFor<4> {
+  using Type = message_filters::sync_policies::ApproximateTime<Cloud, Cloud, Cloud, Cloud>;
+};
+
+/**
+ * @brief Connect N filters to a synchronizer.
+ *
+ * @param sync Synchronizer.
+ * @param filters Input filters.
+ */
+template <std::size_t N, std::size_t... Is>
+void connectFilters(message_filters::Synchronizer<typename PolicyFor<N>::Type>& sync,
+                    std::array<ForwardingFilter, N>& filters,
+                    std::index_sequence<Is...> /*unused*/) {
+  sync.connectInput(std::get<Is>(filters)...);
+}
+
+/**
+ * @brief Collect the point clouds of one synchronizer callback, skipping unused slots.
+ *
+ * @param out Vector that receives the point-cloud pointers.
+ * @param msgs All callback arguments.
+ */
+template <typename... Args>
+void collectClouds(std::vector<CloudConstPtr>& out, const Args&... msgs) {
+  const auto append = [&out](const auto& msg) {
+    if constexpr (std::is_same_v<std::decay_t<decltype(msg)>, CloudConstPtr>) {
+      out.push_back(msg);
+    }
+  };
+  (append(msgs), ...);
+}
+
+// P2: with a const observer in front of the synchronizer on every input (so callbacks_.size() > 1 and
+// nonconst_force_copy is set), the observer and the synchronizer both receive the published object itself.
+TEST(ObserverNoCopy, ConstObserverAndSynchronizerReceiveThePublishedObject) {
+  using Policy = PolicyFor<2>::Type;
+  std::array<ForwardingFilter, 2> filters;
+  std::array<const Cloud*, 2> observed{nullptr, nullptr};
+  std::get<0>(filters).registerCallback([&observed](const CloudConstPtr& msg) { std::get<0>(observed) = msg.get(); });
+  std::get<1>(filters).registerCallback([&observed](const CloudConstPtr& msg) { std::get<1>(observed) = msg.get(); });
+
+  message_filters::Synchronizer<Policy> sync{Policy(10)};
+  connectFilters<2>(sync, filters, std::make_index_sequence<2>{});
+  std::vector<CloudConstPtr> synchronized;
+  sync.registerCallback([&synchronized](const auto&... msgs) { collectClouds(synchronized, msgs...); });
+
+  // Two complete sets; the second one makes the first one final.
+  const std::array<CloudConstPtr, 2> first{makeCloud(1'000'000'000, 1), makeCloud(1'001'000'000, 2)};
+  const std::array<CloudConstPtr, 2> second{makeCloud(1'100'000'000, 3), makeCloud(1'101'000'000, 4)};
+  for (std::size_t input = 0; input < 2; ++input) {
+    filters.at(input).forward(first.at(input));
+    EXPECT_EQ(observed.at(input), first.at(input).get()) << "observer, input " << input;
+  }
+  for (std::size_t input = 0; input < 2; ++input) {
+    filters.at(input).forward(second.at(input));
+  }
+
+  ASSERT_GE(synchronized.size(), 2U);
+  for (std::size_t input = 0; input < 2; ++input) {
+    EXPECT_EQ(synchronized.at(input).get(), first.at(input).get()) << "synchronizer, input " << input;
+  }
+  EXPECT_EQ(std::get<1>(observed), second.at(1).get());
+}
+
+// Negative control: a callback that asks for a mutable message receives a copy, while a const callback on the same
+// filter receives the original. This shows that the identity checks above would detect a copy.
+TEST(ObserverNoCopy, MutableCallbackReceivesACopy) {
+  ForwardingFilter filter;
+  const Cloud* const_seen = nullptr;
+  const Cloud* mutable_seen = nullptr;
+  filter.registerCallback([&const_seen](const CloudConstPtr& msg) { const_seen = msg.get(); });
+  filter.registerCallback(std::function<void(const std::shared_ptr<Cloud>&)>(
+      [&mutable_seen](const std::shared_ptr<Cloud>& msg) { mutable_seen = msg.get(); }));
+  const CloudConstPtr msg = makeCloud(1'000'000'000, 1);
+  filter.forward(msg);
+  EXPECT_EQ(const_seen, msg.get());
+  ASSERT_NE(mutable_seen, nullptr);
+  EXPECT_NE(mutable_seen, msg.get());
+}
+
+/**
+ * @brief Run a fixed trace with jitter, reordering and drops through an N-input synchronizer.
+ *
+ * @param with_observers Register a const observer in front of the synchronizer on every input.
+ * @return For every synchronizer output, the ids (widths) of its point clouds in input order.
+ */
+template <std::size_t N>
+std::vector<std::vector<std::uint32_t>> runTrace(const bool with_observers) {
+  using Policy = typename PolicyFor<N>::Type;
+  std::array<ForwardingFilter, N> filters;
+  std::uint64_t observed = 0;
+  if (with_observers) {
+    for (auto& filter : filters) {
+      filter.registerCallback([&observed](const CloudConstPtr& /*msg*/) { ++observed; });
+    }
+  }
+  message_filters::Synchronizer<Policy> sync{Policy(3)};
+  connectFilters<N>(sync, filters, std::make_index_sequence<N>{});
+  std::vector<std::vector<std::uint32_t>> outputs;
+  sync.registerCallback([&outputs](const auto&... msgs) {
+    std::vector<CloudConstPtr> clouds;
+    collectClouds(clouds, msgs...);
+    std::vector<std::uint32_t> ids;
+    ids.reserve(clouds.size());
+    for (const auto& cloud : clouds) {
+      ids.push_back(cloud->width);
+    }
+    outputs.push_back(ids);
+  });
+
+  // Deterministic trace: 10 Hz per input, stamp jitter +-20 ms, transport delay 0-30 ms, some drops.
+  struct Event {
+    std::int64_t arrival_ns;
+    std::size_t input;
+    CloudConstPtr msg;
+  };
+  std::vector<Event> events;
+  std::uint32_t state = 12345U;
+  const auto next = [&state](const std::uint32_t modulo) {
+    state = state * 1103515245U + 12345U;
+    return (state >> 16U) % modulo;
+  };
+  for (std::uint32_t cycle = 0; cycle < 200; ++cycle) {
+    for (std::size_t input = 0; input < N; ++input) {
+      const std::int64_t jitter_ns = (static_cast<std::int64_t>(next(41)) - 20) * 1'000'000;
+      const std::int64_t delay_ns = static_cast<std::int64_t>(next(31)) * 1'000'000;
+      const bool drop = next(13) == 0;
+      if (drop) {
+        continue;
+      }
+      const std::int64_t stamp_ns = 1'000'000'000 + static_cast<std::int64_t>(cycle) * 100'000'000 + jitter_ns;
+      const auto id = static_cast<std::uint32_t>(input * 1000 + cycle);
+      events.push_back({stamp_ns + delay_ns, input, makeCloud(stamp_ns, id)});
+    }
+  }
+  std::stable_sort(events.begin(), events.end(),
+                   [](const Event& lhs, const Event& rhs) { return lhs.arrival_ns < rhs.arrival_ns; });
+  for (const auto& event : events) {
+    filters.at(event.input).forward(event.msg);
+  }
+  if (with_observers) {
+    EXPECT_EQ(observed, events.size());
+  }
+  return outputs;
+}
+
+// P3-A: the synchronizer output is identical with and without the observers, for the same input sequence.
+TEST(ObserverNoCopy, ObserversDoNotChangeSynchronizerOutput) {
+  const auto baseline2 = runTrace<2>(false);
+  const auto observed2 = runTrace<2>(true);
+  EXPECT_GT(baseline2.size(), 100U);
+  EXPECT_EQ(observed2, baseline2);
+
+  const auto baseline4 = runTrace<4>(false);
+  const auto observed4 = runTrace<4>(true);
+  EXPECT_GT(baseline4.size(), 50U);
+  EXPECT_EQ(observed4, baseline4);
+}
+
