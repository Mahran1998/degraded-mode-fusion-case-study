new file mode 100644
index 0000000..86a4c01
--- /dev/null
+++ b/point_cloud_fusion/include/point_cloud_fusion/input_availability.hpp
@@ -0,0 +1,358 @@
+// Copyright Institute for Automotive Engineering (ika), RWTH Aachen University
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+namespace point_cloud_fusion {
+
+/**
+ * @brief Availability of a single input (layer 1), derived from message arrival times only.
+ */
+enum class InputAvailability : std::uint8_t {
+  kUnknown,     ///< No message since the current epoch started; counted as available during the startup grace.
+  kHealthy,     ///< Messages arrive within the input timeout.
+  kStale,       ///< No message for longer than the input timeout.
+  kRecovering,  ///< Messages arrive again after being stale; not yet counted as available.
+};
+
+/**
+ * @brief Aggregate availability over all inputs (layer 2).
+ */
+enum class AggregateAvailability : std::uint8_t {
+  kNominal,       ///< Every input is healthy or still unknown.
+  kDegraded,      ///< At least the minimum number of inputs is healthy or still unknown.
+  kInsufficient,  ///< Fewer than the minimum number of inputs is healthy or still unknown.
+};
+
+/**
+ * @brief Return a printable name for an input availability state.
+ *
+ * @param state Input availability state.
+ * @return Upper-case state name.
+ */
+const char* toString(InputAvailability state);
+
+/**
+ * @brief Return a printable name for an aggregate availability state.
+ *
+ * @param state Aggregate availability state.
+ * @return Upper-case state name.
+ */
+const char* toString(AggregateAvailability state);
+
+/**
+ * @brief Fixed-size histogram of non-negative durations with log-spaced buckets.
+ *
+ * Bucket k covers durations up to 1 us * 2^((k + 1) / 8), i.e. roughly 9 % resolution from 1 us to about
+ * 4.5 min; longer durations fall into the last bucket. The exact maximum, count and sum are tracked as well.
+ * Adding a sample never allocates.
+ */
+class DurationHistogram {
+ public:
+  /// Number of buckets per octave (factor of two).
+  static constexpr std::size_t kBucketsPerOctave = 8;
+  /// Total number of buckets.
+  static constexpr std::size_t kBucketCount = 224;
+
+  /**
+   * @brief Add one duration sample; negative durations are ignored.
+   *
+   * @param duration_ns Duration in nanoseconds.
+   */
+  void add(std::int64_t duration_ns);
+
+  /**
+   * @brief Number of samples added.
+   *
+   * @return Sample count.
+   */
+  std::uint64_t count() const { return count_; }
+
+  /**
+   * @brief Largest sample added, or 0 if there is none.
+   *
+   * @return Maximum duration in nanoseconds.
+   */
+  std::int64_t max() const { return max_ns_; }
+
+  /**
+   * @brief Mean of all samples, or 0 if there is none.
+   *
+   * @return Mean duration in nanoseconds.
+   */
+  double mean() const;
+
+  /**
+   * @brief Upper bound of the bucket that contains the q-quantile, capped at the exact maximum.
+   *
+   * @param q Quantile in [0, 1].
+   * @return Duration in nanoseconds, or 0 if there is no sample.
+   */
+  std::int64_t quantileUpperBound(double q) const;
+
+  /**
+   * @brief Upper bound of one bucket.
+   *
+   * @param bucket Bucket index.
+   * @return Duration in nanoseconds.
+   */
+  static std::int64_t bucketUpperBound(std::size_t bucket);
+
+  /**
+   * @brief Bucket index for a duration.
+   *
+   * @param duration_ns Non-negative duration in nanoseconds.
+   * @return Bucket index in [0, kBucketCount).
+   */
+  static std::size_t bucketIndex(std::int64_t duration_ns);
+
+ private:
+  std::array<std::uint64_t, kBucketCount> buckets_{};
+  std::uint64_t count_ = 0;
+  std::int64_t max_ns_ = 0;
+  double sum_ns_ = 0.0;
+};
+
+/**
+ * @brief Passive per-input availability monitor (layer 1 and layer 2) with E0 timing statistics.
+ *
+ * The monitor has no ROS dependencies: every time is passed in by the caller as nanoseconds of one clock
+ * (the node uses the ROS clock), so the state machine can be tested with fake time.
+ *
+ * Rules (absolute timeout T, startup grace T, 500 ms recovery window):
+ * - Arrival: UNKNOWN -> HEALTHY; STALE -> RECOVERING; RECOVERING -> HEALTHY once 500 ms have passed since
+ *   recovery started.
+ * - Tick: UNKNOWN -> STALE once the epoch is older than T; HEALTHY or RECOVERING -> STALE once the last arrival
+ *   is older than T; RECOVERING -> HEALTHY once 500 ms have passed since recovery started.
+ * - Aggregate: inputs that are HEALTHY or UNKNOWN count as available. All available -> NOMINAL, at least
+ *   minInputs() available -> DEGRADED, otherwise INSUFFICIENT.
+ *
+ * Time handling:
+ * - A backward jump is detected only in onTick(), against the previous tick, and resets the state to a new epoch.
+ * - onArrival() never resets. An arrival time earlier than the previous arrival (a race with another thread or a
+ *   jump not yet seen by a tick) is counted as a clamp and does not contribute a gap.
+ * - A time of 0 means that the clock has not started yet (ROS time without /clock). Arrivals at time 0 are counted
+ *   but otherwise ignored, and an epoch started at time 0 is re-anchored at the first non-zero time.
+ *
+ * Thread safety: all public member functions may be called concurrently. One internal mutex is held only for
+ * O(number of inputs) work and never while calling back into other code. Nothing allocates after construction.
+ */
+class InputAvailabilityMonitor {
+ public:
+  /// Maximum number of inputs supported.
+  static constexpr std::size_t kMaxInputs = 9;
+  /// Recovery window: a recovering input becomes healthy after receiving messages for this long.
+  static constexpr std::int64_t kRecoveryWindowNs = 500'000'000;
+  /// Capacity of the pending transition log; further transitions are counted as dropped.
+  static constexpr std::size_t kTransitionCapacity = 64;
+
+  /**
+   * @brief One state transition of an input or of the aggregate state.
+   */
+  struct Transition {
+    bool aggregate = false;                                                  ///< True for an aggregate (layer 2) transition.
+    std::size_t input = 0;                                                   ///< Input index (input transitions only).
+    InputAvailability input_from = InputAvailability::kUnknown;              ///< Previous input state.
+    InputAvailability input_to = InputAvailability::kUnknown;                ///< New input state.
+    AggregateAvailability aggregate_from = AggregateAvailability::kNominal;  ///< Previous aggregate state.
+    AggregateAvailability aggregate_to = AggregateAvailability::kNominal;    ///< New aggregate state.
+    std::int64_t time_ns = 0;                                                ///< Time of the transition.
+  };
+
+  /**
+   * @brief Caller-owned buffer that receives pending transitions.
+   */
+  struct TransitionLog {
+    std::array<Transition, kTransitionCapacity> records{};  ///< Transitions, oldest first.
+    std::size_t count = 0;                                  ///< Number of valid records.
+  };
+
+  /**
+   * @brief State and statistics of one input.
+   */
+  struct InputSnapshot {
+    InputAvailability state = InputAvailability::kUnknown;      ///< Current state.
+    std::int64_t last_arrival_ns = 0;                           ///< Last arrival time, 0 if none in this epoch.
+    std::uint64_t arrivals = 0;                                 ///< Arrivals counted (all epochs).
+    std::uint64_t arrivals_before_clock = 0;                    ///< Arrivals while the clock was at 0.
+    std::uint64_t arrival_clamps = 0;                           ///< Arrivals earlier than the previous arrival.
+    std::uint64_t stamp_zero = 0;                               ///< Messages with header stamp 0.
+    std::uint64_t stamp_regressions = 0;                        ///< Header stamp lower than the previous one.
+    std::uint64_t stamp_repeats = 0;                            ///< Header stamp equal to the previous one.
+    DurationHistogram normal_gap;                               ///< Gaps between arrivals that did not cross STALE.
+    DurationHistogram silence;                                  ///< Gaps between arrivals that crossed STALE.
+    DurationHistogram detect_latency;                           ///< Time from the last arrival to STALE.
+    DurationHistogram recovery_time;                            ///< Time from RECOVERING to HEALTHY.
+    DurationHistogram stamp_gap;                                ///< Positive header stamp increments.
+    std::array<std::array<std::uint64_t, 4>, 4> transitions{};  ///< Transition counts [from][to].
+  };
+
+  /**
+   * @brief Copy of the complete monitor state.
+   */
+  struct Snapshot {
+    std::size_t input_count = 0;                                          ///< Number of valid inputs.
+    std::size_t min_inputs = 0;                                           ///< Minimum for DEGRADED.
+    std::int64_t timeout_ns = 0;                                          ///< Input timeout T.
+    std::int64_t epoch_ns = 0;                                            ///< Start of the current epoch.
+    AggregateAvailability aggregate = AggregateAvailability::kNominal;    ///< Current aggregate state.
+    std::array<std::array<std::uint64_t, 3>, 3> aggregate_transitions{};  ///< Transition counts [from][to].
+    std::uint64_t time_jumps = 0;                                         ///< Backward jumps seen by onTick().
+    std::uint64_t transitions_dropped = 0;                                ///< Transitions lost to a full log.
+    DurationHistogram observer_cost;                                      ///< Cost of the arrival observer.
+    std::array<InputSnapshot, kMaxInputs> inputs{};                       ///< Per-input state.
+  };
+
+  /**
+   * @brief Create a monitor for a fixed number of inputs.
+   *
+   * The epoch starts at time 0, which means "not started"; call reset() with the current time.
+   *
+   * @param input_count Number of inputs, in [1, kMaxInputs].
+   * @param timeout_ns Input timeout T in nanoseconds, positive.
+   * @throws std::invalid_argument If an argument is out of range.
+   */
+  InputAvailabilityMonitor(std::size_t input_count, std::int64_t timeout_ns);
+
+  /**
+   * @brief Default minimum number of available inputs for DEGRADED: 1 for up to two inputs, otherwise half,
+   * rounded up.
+   *
+   * @param input_count Number of inputs.
+   * @return Minimum number of inputs.
+   */
+  static std::size_t defaultMinInputs(std::size_t input_count);
+
+  /**
+   * @brief Start a new epoch: every input becomes UNKNOWN and the startup grace restarts.
+   *
+   * Statistics are kept. A time of 0 defers the epoch start to the first non-zero time.
+   *
+   * @param now_ns Current time in nanoseconds.
+   */
+  void reset(std::int64_t now_ns);
+
+  /**
+   * @brief Record the arrival of one message.
+   *
+   * @param input Input index.
+   * @param now_ns Arrival time in nanoseconds.
+   * @param stamp_ns Header stamp of the message in nanoseconds (statistics only).
+   */
+  void onArrival(std::size_t input, std::int64_t now_ns, std::int64_t stamp_ns);
+
+  /**
+   * @brief Evaluate time-driven transitions; call periodically.
+   *
+   * @param now_ns Current time in nanoseconds.
+   */
+  void onTick(std::int64_t now_ns);
+
+  /**
+   * @brief Record the execution time of one arrival observer call.
+   *
+   * @param cost_ns Duration in nanoseconds (steady clock).
+   */
+  void recordObserverCost(std::int64_t cost_ns);
+
+  /**
+   * @brief Move pending transitions into a caller-owned log; transitions that did not fit were counted as dropped.
+   *
+   * @param log Log to fill; previous content is replaced.
+   */
+  void drainTransitions(TransitionLog& log);
+
+  /**
+   * @brief Copy the current state and statistics into a caller-owned snapshot.
+   *
+   * @param snapshot Snapshot to fill.
+   */
+  void snapshot(Snapshot& snapshot) const;
+
+  /**
+   * @brief Current state of one input.
+   *
+   * @param input Input index.
+   * @return Input state.
+   */
+  InputAvailability inputState(std::size_t input) const;
+
+  /**
+   * @brief Current aggregate state.
+   *
+   * @return Aggregate state.
+   */
+  AggregateAvailability aggregateState() const;
+
+ private:
+  /**
+   * @brief Per-input state and statistics.
+   */
+  struct InputRecord {
+    InputSnapshot data;              ///< State and statistics exposed in snapshots.
+    std::int64_t rec_since_ns = 0;   ///< Start of the current recovery.
+    std::int64_t last_stamp_ns = 0;  ///< Previous non-zero header stamp.
+    bool has_arrival = false;        ///< An arrival happened in this epoch.
+    bool has_stamp = false;          ///< last_stamp_ns is valid.
+  };
+
+  /**
+   * @brief Re-anchor an epoch that started before the clock was running.
+   *
+   * @param now_ns Current time in nanoseconds.
+   */
+  void anchorEpochLocked(std::int64_t now_ns);
+
+  /**
+   * @brief Change the state of one input and log the transition.
+   *
+   * @param input Input index.
+   * @param next New state.
+   * @param now_ns Time of the transition.
+   */
+  void setInputStateLocked(std::size_t input, InputAvailability next, std::int64_t now_ns);
+
+  /**
+   * @brief Recompute the aggregate state and log a transition if it changed.
+   *
+   * @param now_ns Time of the evaluation.
+   */
+  void updateAggregateLocked(std::int64_t now_ns);
+
+  /**
+   * @brief Append a transition to the pending log or count it as dropped.
+   *
+   * @param transition Transition to append.
+   */
+  void logTransitionLocked(const Transition& transition);
+
+  /**
+   * @brief Start a new epoch; see reset().
+   *
+   * @param now_ns Current time in nanoseconds.
+   */
+  void resetLocked(std::int64_t now_ns);
+
+  mutable std::mutex mutex_;
+  std::size_t input_count_;
+  std::size_t min_inputs_;
+  std::int64_t timeout_ns_;
+  std::int64_t epoch_ns_ = 0;
+  bool epoch_pending_ = true;
+  bool has_tick_ = false;
+  std::int64_t last_tick_ns_ = 0;
+  AggregateAvailability aggregate_ = AggregateAvailability::kNominal;
+  std::array<std::array<std::uint64_t, 3>, 3> aggregate_transitions_{};
+  std::uint64_t time_jumps_ = 0;
+  std::uint64_t transitions_dropped_ = 0;
+  DurationHistogram observer_cost_;
+  std::array<InputRecord, kMaxInputs> inputs_{};
+  TransitionLog pending_;
+};
+
+}  // namespace point_cloud_fusion
